+use super::{SocketBinding, SocketLease};
+use norma::codex::UnixListener;
+
+/// 场景：原socket被移走，原路径出现新文件时，旧binding关闭不得误删新正文。
+/// 构造：真实AF_UNIX端点与租约，捕获OS文件身份后关闭listener，再rename并写入不同正文。
+/// 执行：释放原binding，分别检查替代文件与被移动端点。
+/// 预期：两条路径均保留，不把拥有旧文件身份当作仍拥有原路径。
+#[test]
+fn replaced_path_keeps_user_file_and_moved_socket() {
+    let dir = tempfile::Builder::new()
+        .prefix("nab-")
+        .tempdir_in(if cfg!(windows) {
+            std::env::temp_dir()
+        } else {
+            "/tmp".into()
+        })
+        .unwrap();
+    let path = dir.path().join("s.sock");
+    let moved = dir.path().join("old.sock");
+    let lease = SocketLease::acquire(&path).unwrap();
+    let listener = UnixListener::bind(&path).unwrap();
+    let binding = SocketBinding::capture(path.clone(), lease).unwrap();
+    drop(listener);
+    std::fs::rename(&path, &moved).expect("共享删除句柄必须允许端点重命名");
+    std::fs::write(&path, b"replacement-user-data").unwrap();
+    drop(binding);
+    assert_eq!(
+        std::fs::read(&path).unwrap(),
+        b"replacement-user-data",
+        "旧binding不能删除替代正文"
+    );
+    assert!(
+        moved.exists(),
+        "旧binding失去路径归属后也不能擅自删除被移动文件"
+    );
+}
+
+/// 场景：上次进程遗留的非活动socket允许在持有独占租约时重新绑定。
+/// 构造：真实端点关闭后保留原socket文件；通过App入口重建listener。
+/// 执行：重新绑定并关闭，检查残留清理。
+/// 预期：正常接管陈旧端点，最终删除自己拥有的文件，而不是误判仍有活动宿主。
+#[test]
+fn inactive_socket_is_rebound_and_owned_cleanup_completes() {
+    let dir = tempfile::Builder::new()
+        .prefix("nas-")
+        .tempdir_in(if cfg!(windows) {
+            std::env::temp_dir()
+        } else {
+            "/tmp".into()
+        })
+        .unwrap();
+    let path = dir.path().join("s.sock");
+    drop(UnixListener::bind(&path).unwrap());
+    assert!(
+        path.exists(),
+        "必须实际留下陈旧端点，不能把不存在路径当作恢复测试"
+    );
+    let listener = super::super::NormaSocketListener::bind(path.clone()).unwrap();
+    drop(listener);
+    assert!(!path.exists(), "恢复后正常关闭必须完成归属文件清理");
+}
+
+/// 场景：检查陈旧socket之后、连接探测期间发生路径替换，不能删除新正文。
+/// 构造：真实陈旧端点；探测回调精确在身份检查后rename旧文件并写入替代标记。
+/// 执行：走实际prepare入口的连接探测边界，再读取替代文件。
+/// 预期：替代正文和移动端点均保留，并返回AddrInUse，禁止先验证后裸路径删除。
+#[test]
+fn stale_probe_path_exchange_never_deletes_replacement() {
+    let dir = tempfile::Builder::new()
+        .prefix("nae-")
+        .tempdir_in(if cfg!(windows) {
+            std::env::temp_dir()
+        } else {
+            "/tmp".into()
+        })
+        .unwrap();
+    let path = dir.path().join("s.sock");
+    let moved = dir.path().join("old.sock");
+    drop(UnixListener::bind(&path).unwrap());
+    let result = super::prepare_socket_path_with(&path, |path| {
+        std::fs::rename(path, &moved).unwrap();
+        std::fs::write(path, b"new-user-data").unwrap();
+        false
+    });
+    assert_eq!(
+        std::fs::read(&path).expect("陈旧探测不能删掉替代正文"),
+        b"new-user-data",
+        "路径交换后必须保留用户正文"
+    );
+    assert!(moved.exists(), "不能顺带删除已移动的旧文件");
+    assert_eq!(
+        result.unwrap_err().kind(),
+        std::io::ErrorKind::AddrInUse,
+        "身份变化必须明确拒绝绑定"
+    );
+}
diff --git a/crates/app/tests/unit/app_transport_deadline_tests.rs b/crates/app/tests/unit/app_transport_deadline_tests.rs
new file mode 100644
index 00000000..59346b3f
--- /dev/null
+++ b/crates/app/tests/unit/app_transport_deadline_tests.rs
@@ -0,0 +1,67 @@
+use super::*;
+use std::sync::atomic::AtomicBool;
+use std::time::Instant;
+
+/// 场景：不足每次read超时的无换行碎片，不能无限延长同一条NDJSON请求。
+/// 构造：真实Socket pair，50×75ms=3.75秒慢滴，每次间隔远小于原2秒流超时。
+/// 执行：实际handle_stream读取，返回后回收发送方与线程。
+/// 预期：整条请求在3秒内失败、不进入App队列；每次读到碎片都重新计时会使此测试失败。
+#[test]
+fn dripping_partial_line_has_one_request_deadline() {
+    let (mut client, bridge) = UnixStream::pair().unwrap();
+    let stop = Arc::new(AtomicBool::new(false));
+    let stopped = stop.clone();
+    let writer = std::thread::spawn(move || {
+        for _ in 0..50 {
+            if stopped.load(Ordering::Acquire) || client.write_all(b" ").is_err() {
+                break;
+            }
+            std::thread::sleep(Duration::from_millis(75));
+        }
+    });
+    let (sender, requests) = bounded(1);
+    let start = Instant::now();
+    handle_stream(bridge, sender, &AtomicBool::new(false));
+    let elapsed = start.elapsed();
+    stop.store(true, Ordering::Release);
+    writer.join().unwrap();
+    assert!(
+        elapsed < Duration::from_secs(3),
+        "碎片不能续期整条请求：{elapsed:?}"
+    );
+    assert!(requests.try_recv().is_err(), "未完成NDJSON不能进入App队列");
+}
+
+/// 场景：读取预算按UTF8字节计数，字符跨read到达也不能被误判为损坏。
+/// 构造：é占2字节，加换行共3字节，恰好等于预算；第一个UTF8字节单独送达。
+/// 执行：用真实Socket分段写入，并在换行后附加另一条数据。
+/// 预期：只返回完整首行，不读入换行后的数据，也不把未完整的字符提前解码。
+#[test]
+fn request_limit_counts_complete_utf8_wire_bytes() {
+    let (mut client, mut bridge) = UnixStream::pair().unwrap();
+    let writer = std::thread::spawn(move || {
+        client.write_all(&[0xc3]).unwrap();
+        std::thread::sleep(Duration::from_millis(20));
+        client.write_all(&[0xa9, b'\n', b'x']).unwrap();
+    });
+    let line = read_request_line(&mut bridge, &AtomicBool::new(false), 3).unwrap();
+    writer.join().unwrap();
+    assert_eq!(line, "é\n", "UTF8跨read必须保留且只读一条帧");
+    assert_eq!(line.len(), 3, "预算必须按字节而非字符计算");
+}
+
+/// 场景：输入达到资源边界后还多1字节必须拒绝。
+/// 构造：4字节预算与5字节完整行abcd换行，不需要分配生产64MiB测试数据。
+/// 执行：通过实际有界读取函数处理真实Socket数据。
+/// 预期：InvalidData，而不是截断为合法请求或等待更多正文。
+#[test]
+fn oversized_request_is_rejected_without_truncation() {
+    let (mut client, mut bridge) = UnixStream::pair().unwrap();
+    client.write_all(b"abcd\n").unwrap();
+    let error = read_request_line(&mut bridge, &AtomicBool::new(false), 4).unwrap_err();
+    assert_eq!(
+        error.kind(),
+        ErrorKind::InvalidData,
+        "超限不能截断或改写请求"
+    );
+}
diff --git a/crates/app/tests/unit/mobile_image_platform_tests.rs b/crates/app/tests/unit/mobile_image_platform_tests.rs
new file mode 100644
index 00000000..408666cf
--- /dev/null
+++ b/crates/app/tests/unit/mobile_image_platform_tests.rs
@@ -0,0 +1,75 @@
+use crate::image_store;
+use image::{ImageFormat, Rgb, RgbImage};
+use sha2::{Digest, Sha256};
+use std::io::Cursor;
+
+fn png() -> Vec<u8> {
+    let image = RgbImage::from_pixel(2, 2, Rgb([7, 19, 31]));
+    let mut bytes = Cursor::new(Vec::new());
+    image.write_to(&mut bytes, ImageFormat::Png).unwrap();
+    bytes.into_inner()
+}
+
+/// 场景：手机附件必须通过真实图片校验并在私有目录中原样保存和读取。
+/// 构造：2×2 PNG以及正文SHA-256地址；隔离根目录/项目目录均由实际store创建。
+/// 执行：验证、保存、读取同一图片，随后破坏正文再次读取。
+/// 预期：首轮字节完全相同；篡改后不能返回正文，也不能把坏图当作成功附件。
+#[test]
+fn image_roundtrip_then_tampering_is_rejected() {
+    let temp = tempfile::tempdir().unwrap();
+    let folder = temp.path().join("attachments").join("project");
+    let bytes = png();
+    assert_eq!(
+        image_store::validate(&bytes),
+        Ok("png"),
+        "真实PNG应通过解码和尺寸校验"
+    );
+    let id = format!("{:x}", Sha256::digest(&bytes));
+    let path = image_store::save(&folder, &id, "png", &bytes).unwrap();
+    let (_, loaded) = image_store::read(&folder, &id).unwrap();
+    assert_eq!(loaded, bytes, "读回必须等于原附件，不能截断或替换");
+    std::fs::write(path, b"tampered").unwrap();
+    assert_eq!(
+        image_store::read(&folder, &id).unwrap_err(),
+        "invalid_image",
+        "哈希地址不能返回被替换的正文"
+    );
+}
+
+/// 场景：附件父目录被普通文件占据时必须拒绝，不得覆盖用户文件。
+/// 构造：attachments路径写入固定标记，项目目录尚不存在。
+/// 执行：实际save尝试建目录。
+/// 预期：明确存储错误且标记不变，不留下部分附件。
+#[test]
+fn image_parent_file_is_preserved() {
+    let temp = tempfile::tempdir().unwrap();
+    let parent = temp.path().join("attachments");
+    std::fs::write(&parent, b"keep").unwrap();
+    let bytes = png();
+    let id = format!("{:x}", Sha256::digest(&bytes));
+    assert_eq!(
+        image_store::save(&parent.join("project"), &id, "png", &bytes).unwrap_err(),
+        "image_storage_unavailable",
+        "非目录父路径必须拒绝"
+    );
+    assert_eq!(std::fs::read(parent).unwrap(), b"keep", "不得覆盖原文件");
+}
+
+/// 场景：读取超过2MiB的缓存正文必须拒绝，即使文件名匹配其真实哈希。
+/// 构造：实际LIMIT+1字节，超过上限仅1字节，不需要解码大图片。
+/// 执行：把正文放入真实项目目录并调用实际读取入口。
+/// 预期：invalid_image，不能因内容寻址正确而绕过资源上限。
+#[test]
+fn oversized_image_file_cannot_bypass_read_limit() {
+    let temp = tempfile::tempdir().unwrap();
+    let folder = temp.path().join("attachments").join("project");
+    std::fs::create_dir_all(&folder).unwrap();
+    let bytes = vec![3; image_store::LIMIT + 1];
+    let id = format!("{:x}", Sha256::digest(&bytes));
+    std::fs::write(folder.join(format!("{id}.png")), bytes).unwrap();
+    assert_eq!(
+        image_store::read(&folder, &id).unwrap_err(),
+        "invalid_image",
+        "超过实际协议上限的文件必须拒绝"
+    );
+}
