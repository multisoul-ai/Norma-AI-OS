# Copy to .env and fill secrets:
#   cp .env.example .env
#   openssl rand -hex 32  # paste into JWT_SECRET and LICENSE_SIGNING_KEY (different values)

JWT_SECRET=
LICENSE_SIGNING_KEY=

# Auto-promoted on first OTP login (comma-separated). Used by bootstrap.sh.
ADMIN_EMAILS=spike-admin@example.com

# Public API base (scripts). Must match docker-compose BASE_URL host/port.
KEYGATE_BASE_URL=http://localhost:9000
