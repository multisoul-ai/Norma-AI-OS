{
  "manifest_version": 3,
  "name": "Norma OS Browser Session Bridge",
  "description": "Shares cookies for a user-requested URL with a running Norma OS Browser card.",
  "version": "1.0.0",
  "minimum_chrome_version": "119",
  "key": "",
  "permissions": [
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Norma OS Browser session bridge"
  }
}
