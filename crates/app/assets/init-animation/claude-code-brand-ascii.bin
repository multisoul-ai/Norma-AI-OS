                                ╜ллллллллллллллллллллллллллллллллллл                                                                ╜ллллллллллллллллллллллллллллллллллл                                                                ╜ллллллллллллллллллллллллллллллллллл                                                                ╜ллл    лллл            ╜лл╜    лллл                                                                ╜ллл    лллл            ╜лл╜    лллл                                                                ╜ллл    лллл            ╜лл╜    лллл                                                                ╜ллл    лллл            ╜лл╜    лллл                                                                ╜╜╜╜    ╜╜╜╜            ╜╜╜╜    ╜╜╜╜                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                