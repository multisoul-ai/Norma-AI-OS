[Unit]
Description=Norma Doubao voice gateway
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/norma-voice/gateway.env

[Service]
Type=simple
User=norma-voice
Group=norma-voice
WorkingDirectory=/opt/norma-voice/current
EnvironmentFile=/etc/norma-voice/gateway.env
ExecStart=/opt/norma-voice/node-v22.23.2-linux-x64/bin/node --dns-result-order=ipv4first server.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
CPUQuota=40%
MemoryMax=256M
TasksMax=32
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
