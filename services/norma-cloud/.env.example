# Production defaults for /etc/norma-cloud/gateway.env. Never commit secrets.
# Local development: PUBLIC_ORIGIN=http://127.0.0.1:8787, PORT=8787; copy to .env.

# Server administration/local debugging only; default iOS receives Mac-signed authorization.
COMPANION_ACCESS_TOKEN=replace-with-your-private-passphrase-at-least-24-characters
DOUBAO_PROTOCOL=plan
DOUBAO_SPEECH_API_KEY=replace-with-your-volcengine-plan-api-key
PUBLIC_ORIGIN=https://soulvoiceai.com/norma/voice
NORMA_CLOUD_DEVICE_STATE=/var/lib/norma-cloud/devices.json
# NORMA_TEXT_DAILY_LIMIT=300
HOST=127.0.0.1
PORT=8789
# Optional push module: copy the five settings from deploy/push.env.example into this .env.
# No APNs settings disables push; partial/invalid settings reject startup. No separate push port.
# Optional GPT transport; use the same OpenAI project as the paired Mac.
# OPENAI_API_KEY=

# Required for the Vercel entry point (reuse your existing Redis integration):
# KV_REST_API_URL=https://your-redis-rest-endpoint
# KV_REST_API_TOKEN=your-private-redis-token
# JSON array of base64 DER PUBLIC certificates from trusted Mac installations. Never add private keys.
NORMA_VOICE_TRUSTED_CERTIFICATES=[]
# Local collaboration relay uses its own explicit Mac allowlist (base64 DER PUBLIC certificates).
# Phone access reuses NORMA_CLOUD_DEVICE_STATE; no provider key is required for forwarding.
NORMA_RELAY_TRUSTED_CERTIFICATES=[]

# Optional account login (GitHub / Google). No variable set disables it; any variable set requires a valid, complete config.
# Public origin as seen by the browser, without trailing slash. Nginx maps /norma/v1/auth/ to 127.0.0.1:8789/v1/auth/.
# NORMA_AUTH_PUBLIC_ORIGIN=https://soulvoiceai.com/norma
# NORMA_AUTH_SIGNING_KEY=replace-with-64-or-more-hex-characters
# NORMA_AUTH_ACCOUNTS_PATH=/var/lib/norma-cloud/accounts.json
# Each provider needs both values; callback URL: <NORMA_AUTH_PUBLIC_ORIGIN>/v1/auth/<provider>/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
